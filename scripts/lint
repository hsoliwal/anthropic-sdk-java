#!/usr/bin/env bash

set -e

cd "$(dirname "$0")/.."

echo "==> Running lints"

# Run every lint task in a single Gradle invocation so we pay buildSrc
# compilation and project configuration once, not once per task.
if [[ -n "${CI:-}" ]]; then
    # When detekt checks only the changed files it cannot show a problem that an
    # edit causes in a file that did not change, so in CI it checks every file.
    gradle_tasks=(detektMain detektTest)
    # Upstream has a dedicated large runner for full detekt. Forks use standard
    # GitHub-hosted runners: retain the repository's 6g Gradle heap and limit
    # concurrent workers there, rather than requesting a 16g heap on that host.
    if [[ "${GITHUB_REPOSITORY:-}" == "anthropics/anthropic-sdk-java" ]]; then
        gradle_flags=("-Dorg.gradle.jvmargs=-Xmx16g -XX:+UseParallelGC -XX:ReservedCodeCacheSize=512m -XX:MaxMetaspaceSize=1G")
    else
        gradle_flags=(--max-workers=2)
    fi
else
    echo "==> detekt checks only the files that changed since it last passed; run ./gradlew lint to have detekt check every file"
    gradle_tasks=(detektChangedMain detektChangedTest)
    gradle_flags=()
fi

# Whether a file is formatted does not depend on any other file, so lintKotlin
# and lintJava skip files not modified since a run in which they passed.
gradle_tasks+=(lintKotlin lintJava)

echo "==> Running gradlew ${gradle_tasks[*]}"
./gradlew "${gradle_flags[@]}" "${gradle_tasks[@]}"

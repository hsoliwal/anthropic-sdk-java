#!/usr/bin/env bash

set -e

cd "$(dirname "$0")/.."

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
NC='\033[0m' # No Color

function steady_is_running() {
  bash scripts/steady-health "http://127.0.0.1:4010/_x-steady/health" >/dev/null 2>&1
}

stop_owned_mock() {
  local pid="$1"
  # Never kill a PID that no longer owns the Steady listening socket.
  if lsof -a -p "$pid" -i tcp:4010 -sTCP:LISTEN >/dev/null 2>&1; then
    kill "$pid" || true
    echo "Stopped owned mock process $pid on port 4010."
  fi
}

function is_overriding_api_base_url() {
  [ -n "$TEST_API_BASE_URL" ]
}

if ! is_overriding_api_base_url && ! steady_is_running ; then
  # A failing health probe is not proof the listening process belongs to us.
  # Refuse to replace or kill any listener we did not start.
  if ! command -v lsof >/dev/null 2>&1; then
    echo "ERROR: lsof is required to track and clean up the mock process" >&2
    exit 1
  fi
  if lsof -t -i tcp:4010 -sTCP:LISTEN >/dev/null 2>&1; then
    echo "ERROR: Port 4010 is occupied by a listener with an unhealthy Steady probe" >&2
    exit 1
  fi

  # Do not register cleanup until our own server has started successfully.
  ./scripts/mock --daemon
  owned_mock_pid=$(lsof -t -i tcp:4010 -sTCP:LISTEN | head -n 1)
  if [[ -z "$owned_mock_pid" ]]; then
    echo "ERROR: Mock startup succeeded but its listener PID was not found" >&2
    exit 1
  fi
  trap 'stop_owned_mock "$owned_mock_pid"' EXIT
fi

if is_overriding_api_base_url ; then
  echo -e "${GREEN}✔ Running tests against ${TEST_API_BASE_URL}${NC}"
  echo
elif ! steady_is_running ; then
  echo -e "${RED}ERROR:${NC} The test suite will not run without a mock Steady server"
  echo -e "running against your OpenAPI spec."
  echo
  echo -e "To run the server, pass in the path or url of your OpenAPI"
  echo -e "spec to the steady command:"
  echo
  echo -e "  \$ ${YELLOW}npm exec --package=@stdy/cli@0.22.2 -- steady path/to/your.openapi.yml --host 127.0.0.1 -p 4010 --validator-query-array-format=brackets --validator-form-array-format=brackets --validator-query-object-format=brackets --validator-form-object-format=brackets${NC}"
  echo

  exit 1
else
  echo -e "${GREEN}✔ Mock steady server is running with your OpenAPI spec${NC}"
  echo
fi

echo "==> Running tests"
./gradlew check "$@"

